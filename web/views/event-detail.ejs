<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Event Details</title>
  <link rel="stylesheet" href="/css/tailwind.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

  <style>
    .copilot-section {
      margin-bottom: 1.25rem;
    }
    .copilot-section-title {
      font-size: 0.75rem;
      font-weight: 600;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }
    .copilot-file-path {
      font-size: 0.7rem;
      font-family: monospace;
      color: #4f46e5;
      background: #eef2ff;
      padding: 0.2rem 0.6rem;
      border-radius: 0.25rem 0.25rem 0 0;
      border: 1px solid #c7d2fe;
      border-bottom: none;
      display: inline-block;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .copilot-code-block {
      margin: 0;
      border-radius: 0 0.375rem 0.375rem 0.375rem;
      border: 1px solid #e5e7eb;
      overflow-x: auto;
      font-size: 0.75rem;
    }
    .copilot-code-block code {
      border-radius: 0 0.375rem 0.375rem 0.375rem;
    }
    .copilot-diff pre {
      background: #1f2937;
      color: #f9fafb;
      border-radius: 0.375rem;
      padding: 0.75rem 1rem;
      font-size: 0.75rem;
      overflow-x: auto;
      white-space: pre;
    }
    .download-link {
      display: inline-block;
      padding: 8px 16px;
      font-size: 14px;
      font-weight: 500;
      color: #fff;
      background: linear-gradient(135deg, #6e8efb, #a777e3);
      border-radius: 25px;
      text-decoration: none;
      transition: all 0.25s ease-in-out;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .download-link:hover {
      background: linear-gradient(135deg, #a777e3, #6e8efb);
      transform: translateY(-2px);
    }

    .download-link::after {
      content: ' ↓';
      font-size: 12px;
    }

  </style>
</head>
<body class="bg-gray-50 p-8">
  <div class="max-w-3xl mx-auto bg-white rounded-lg shadow p-6">
    <h1 class="text-2xl font-bold text-indigo-700 mb-4">Event Details</h1>

    <div class="mb-4 text-sm text-gray-600">
      <span class="font-medium">Timestamp:</span> <%= event.timestamp.toISOString() %>
    </div>
    <% if (event.user) { %>
      <div class="mb-4 text-sm text-gray-600">
        <span class="font-medium">User:</span> <%= event.user %>
      </div>
    <% } %>
    <div class="mb-4 text-sm text-gray-600">
      <span class="font-medium">Site:</span> <%= event.site %>
    </div>
    <% if (event.source_ip) { %>
      <div class="mb-4 text-sm text-gray-600">
        <span class="font-medium">Source IP:</span> <%= event.source_ip %>
      </div>
    <% } %>

    <div class="mb-4 text-sm text-gray-600">
      <span class="font-medium">Rational:</span> <%= event.rational %>
    </div>
    <% if (event.content && permissions.includes('conversations')) { %>
      <div class="mb-4">
        <h2 class="text-sm font-semibold text-gray-600 mb-1">Prompt</h2>
        <div class="flex items-start gap-2">
          <span class="mt-1 text-indigo-500 text-lg">🧑</span>
          <p class="flex-1 text-gray-700 whitespace-pre-wrap bg-indigo-50 p-3 rounded-lg border border-indigo-100"><%= event.content %></p>
        </div>
      </div>
    <% } %>

    <% if (event.response && permissions.includes('conversations')) { %>
      <div class="mb-4">
        <h2 class="text-sm font-semibold text-gray-600 mb-1">Response</h2>
        <div class="flex items-start gap-2">
          <span class="mt-1 text-green-500 text-lg">🤖</span>
          <p class="flex-1 text-gray-700 whitespace-pre-wrap bg-green-50 p-3 rounded-lg border border-green-100"><%= event.response %></p>
        </div>
      </div>
    <% } %>

    <% if (event.conversation_id) { %>
      <div class="mb-4">
        <a href="/conversation/<%= event.conversation_id %>"
           class="inline-flex items-center gap-1 text-sm text-indigo-600 hover:text-indigo-800 underline">
          💬 View full conversation thread
        </a>
      </div>
    <% } %>

    <% if (event.rational === "Attached file" && event.filename) { %>
      <a href="<%= event.filepath %>?name=<%= event.filename %>" class="download-link" download>
        Download <%= event.filename %>
      </a>
    <% } %>

    <% if (event.leak) { %>
      <div class="mt-4 space-y-2">
        <% Object.entries(event.leak.regex || {}).forEach(([k, v]) => { %>
          <span class="inline-block px-2 py-1 bg-indigo-100 text-indigo-700 text-xs rounded-full"><%= k %>: <%= v %></span>
        <% }) %>
        <% (event.leak.topic || []).forEach(t => { %>
          <span class="inline-block px-2 py-1 bg-green-100 text-green-700 text-xs rounded-full"><%= t.name %></span>
        <% }) %>
        <% (event.leak.yara || []).forEach(y => { %>
          <span class="inline-block px-2 py-1 bg-yellow-100 text-yellow-700 text-xs rounded-full"><%= y.name %></span>
        <% }) %>
      </div>
      
    <% } %>

    <% if (event.content && permissions.includes('conversations')) { %>
      <!-- Add Conversation to Topic Rules Button with Tooltip -->
      <div class="mt-6 flex items-center space-x-2">
        <form action="/add-event-to-topic-rules" method="POST">
          <input type="hidden" name="eventId" value="<%= event._id %>">
          <!-- Name Input -->
          <input
            type="text"
            name="name"
            required
            placeholder="Enter topic name"
            class="px-3 py-2 border border-gray-300 rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
          <button type="submit"
            class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-full shadow transition">
            Add Conversation to Topic Rules
          </button>
        </form>

        <!-- Tooltip icon -->
        <div class="relative group">
          <span class="inline-block w-5 h-5 text-white bg-gray-400 rounded-full text-center leading-5 cursor-help">?</span>
          <div
            class="absolute bottom-full mb-2 hidden group-hover:block bg-gray-700 text-white text-xs rounded px-3 py-2 w-64 shadow-lg">
            This will include the conversation content in future topic matching rules, helping refine leak detection.
          </div>
        </div>
      </div>
    <% } %>

    <% if (event.copilot_context && permissions.includes('conversations')) { %>
      <div class="mt-6 border-t border-gray-100 pt-6">
        <h2 class="text-base font-semibold text-indigo-700 mb-4">GitHub Copilot Context</h2>

        <% if (event.copilot_context.user_question) { %>
          <div class="copilot-section">
            <div class="copilot-section-title">User question</div>
            <p class="text-sm text-gray-700 bg-indigo-50 border border-indigo-100 rounded-lg p-3 whitespace-pre-wrap"><%= event.copilot_context.user_question %></p>
          </div>
        <% } %>

        <% if (event.copilot_context.current_file) { %>
          <div class="copilot-section">
            <div class="copilot-section-title">Current file</div>
            <div class="copilot-file-path"><%= event.copilot_context.current_file.file_path %></div>
            <pre class="copilot-code-block"><code class="language-<%= event.copilot_context.current_file.language %>"><%= event.copilot_context.current_file.code %></code></pre>
          </div>
        <% } %>

        <% if (event.copilot_context.code_to_edit) { %>
          <div class="copilot-section">
            <div class="copilot-section-title">Code to edit</div>
            <% var editLang = event.copilot_context.current_file ? event.copilot_context.current_file.language : 'plaintext'; %>
            <pre class="copilot-code-block"><code class="language-<%= editLang %>"><%= event.copilot_context.code_to_edit %></code></pre>
          </div>
        <% } %>

        <% if (event.copilot_context.edit_diff_history) { %>
          <div class="copilot-section">
            <div class="copilot-section-title">Recent edits (diff)</div>
            <div class="copilot-diff"><pre><%= event.copilot_context.edit_diff_history %></pre></div>
          </div>
        <% } %>

        <% if (event.copilot_context.recently_viewed_snippets && event.copilot_context.recently_viewed_snippets.length > 0) { %>
          <div class="copilot-section">
            <div class="copilot-section-title">Recently viewed snippets (<%= event.copilot_context.recently_viewed_snippets.length %>)</div>
            <% event.copilot_context.recently_viewed_snippets.forEach(function(snippet) { %>
              <div class="mb-3">
                <div class="copilot-file-path"><%= snippet.file_path %></div>
                <pre class="copilot-code-block"><code class="language-<%= snippet.language %>"><%= snippet.code %></code></pre>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="mt-6">
      <a href="<%= backUrl %>" class="text-sm text-indigo-600 underline hover:text-indigo-800">← Back to activity</a>
    </div>


  </div>

  <% if (event.copilot_context) { %>
    <script>hljs.highlightAll();</script>
  <% } %>

</body>
</html>
